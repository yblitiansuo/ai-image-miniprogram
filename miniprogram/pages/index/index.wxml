<!-- pages/index/index.wxml -->
<view class="container">
  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{tasks.length === 0}}">
    <view class="empty-icon">
      <view class="empty-icon-box">
        <view class="empty-icon-plus"></view>
      </view>
    </view>
    <text class="empty-title">创建第一个任务</text>
    <text class="empty-desc">上传商品图，AI 自动生成\n不同场景的商品展示图</text>
    <button class="empty-btn" bindtap="onCreateTask">新建任务</button>
  </view>

  <!-- 任务列表 -->
  <view class="task-list" wx:if="{{tasks.length > 0}}">
    <view class="task-card {{item.status === 'processing' ? 'processing' : ''}}"
          wx:for="{{tasks}}" wx:key="id"
          bindtap="onEditTask" data-index="{{index}}">
      <view class="task-row">
        <!-- 缩略图 -->
        <view class="task-thumb {{item.status === 'processing' ? 'scanning' : ''}}">
          <image wx:if="{{item.productImage}}" class="thumb-img" src="{{item.productImage}}" mode="aspectFill"/>
          <view wx:else class="thumb-placeholder">
            <view class="thumb-icon-box">
              <view class="thumb-icon-mountain"></view>
              <view class="thumb-icon-sun"></view>
            </view>
          </view>
        </view>

        <!-- 任务信息 -->
        <view class="task-info">
          <view class="task-name-row">
            <text class="task-name">任务 {{index + 1}}</text>
            <text class="task-status status-{{item.status}}">{{item.statusText}}</text>
          </view>
          <text wx:if="{{item.text}}" class="task-meta">文案：{{item.text}}</text>
          <text wx:if="{{item.prompt}}" class="task-meta">提示词：{{item.prompt}}</text>
          <text class="task-time">{{item.createTime || ''}}</text>
        </view>

        <!-- 删除 -->
        <view class="task-delete" catchtap="onDeleteTask" data-index="{{index}}" data-id="{{item.backendTaskId || item.id}}">×</view>
      </view>

      <!-- 结果展示 -->
      <scroll-view class="result-strip" scroll-x wx:if="{{item.resultUrls.length > 0}}">
        <view class="result-thumb" wx:for="{{item.resultUrls}}" wx:for-item="url" wx:key="*this"
              data-url="{{url}}" bindtap="previewImage">
          <image class="result-img" src="{{url}}" mode="aspectFill"/>
        </view>
        <view class="result-save" data-urls="{{item.resultUrls}}" data-index="{{index}}"
              bindtap="onSaveResult">保存全部</view>
      </scroll-view>
    </view>

    <!-- 全部提交 -->
    <button class="batch-btn" bindtap="onBatchSubmit"
            wx:if="{{readyCount > 0 && statusCount.processing === 0}}">
      全部提交（{{readyCount}}个任务）
    </button>
  </view>

  <!-- 创建任务面板 -->
  <view class="sheet-overlay" wx:if="{{showTaskPanel}}" bindtap="onOverlayTap">
    <view class="sheet-panel">
      <view class="sheet-handle"></view>
      <view class="sheet-header">
        <text class="sheet-title">{{editingTaskIndex === null ? '创建任务' : '编辑任务'}}</text>
        <view class="sheet-close" bindtap="closeTaskPanel">×</view>
      </view>
      <scroll-view class="sheet-body" scroll-y>
        <!-- 商品图 -->
        <view class="form-group">
          <text class="form-label">商品图</text>
          <view class="upload-zone" wx:if="{{!taskForm.productImage}}"
                bindtap="showProductPicker">
            <view class="upload-icon-camera"></view>
            <text class="upload-hint">拍照或从相册选择</text>
          </view>
          <view wx:else class="upload-preview">
            <image class="uploaded-img" src="{{taskForm.productImage}}" mode="aspectFill"/>
            <view class="upload-actions">
              <text class="upload-link" bindtap="showProductPicker">更换</text>
              <text class="upload-link danger" bindtap="onRemoveProductImage">删除</text>
            </view>
          </view>
        </view>
        <!-- 参考图 -->
        <view class="form-group">
          <text class="form-label">参考图</text>
          <view class="upload-zone" wx:if="{{!taskForm.refImage}}"
                bindtap="showRefPicker">
            <view class="upload-icon-pic"></view>
            <text class="upload-hint">拍照或从相册选择</text>
          </view>
          <view wx:else class="upload-preview">
            <image class="uploaded-img" src="{{taskForm.refImage}}" mode="aspectFill"/>
            <view class="upload-actions">
              <text class="upload-link" bindtap="showRefPicker">更换</text>
              <text class="upload-link danger" bindtap="onRemoveRefImage">删除</text>
            </view>
          </view>
        </view>
        <!-- 文案 -->
        <view class="form-group">
          <text class="form-label">自定义文案</text>
          <textarea class="form-input" value="{{taskForm.text}}"
                    bindinput="onTaskTextInput" placeholder="如：限时特惠 5折起"
                    maxlength="100" auto-height/>
          <text class="form-count">{{taskForm.text.length}}/100</text>
        </view>
        <!-- 提示词 -->
        <view class="form-group">
          <text class="form-label">提示词</text>
          <textarea class="form-input" value="{{taskForm.prompt}}"
                    bindinput="onTaskPromptInput" placeholder="如：白色背景，产品居中"
                    maxlength="300" auto-height/>
          <text class="form-count">{{taskForm.prompt.length}}/300</text>
        </view>
      </scroll-view>
      <view class="sheet-footer">
        <button class="sheet-btn-cancel" bindtap="closeTaskPanel">取消</button>
        <button class="sheet-btn-save" bindtap="saveTask"
                disabled="{{!taskForm.productImage || !taskForm.refImage}}">保存</button>
      </view>
    </view>
  </view>

  <!-- FAB -->
  <view class="fab" bindtap="onCreateTask">+</view>
</view>
