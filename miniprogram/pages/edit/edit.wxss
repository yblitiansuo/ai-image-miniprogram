/* pages/edit/edit.wxss */
page {
  background: #fafaf8;
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.canvas-container {
  position: relative;
  width: 100%;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

#editCanvas {
  width: 100%;
  height: 100%;
}

.toolbar {
  background: #ffffff;
  padding: 16rpx 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  justify-content: flex-end;
  border-top: 2rpx solid #e8e8e6;
}

.btn {
  background: #f2f2f0;
  color: #1a1a1a;
  border: none;
  padding: 16rpx 28rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
}

.btn:active {
  background: #e0e0dc;
}

.btn-primary {
  background: #1a1a1a;
  color: #ffffff;
}

.btn-primary:active {
  opacity: 0.85;
}

.aspect-options {
  display: flex;
  gap: 10rpx;
}

.aspect-btn {
  padding: 12rpx 22rpx;
  background: #f2f2f0;
  color: #1a1a1a;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.aspect-btn.active {
  background: #1a1a1a;
  color: #ffffff;
}

.crop-info {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  background: rgba(0,0,0,0.7);
  color: #ffffff;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.check-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 10rpx;
  background-color: rgba(58, 138, 74, 0.9);
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}