/* pages/purchase/purchase.wxss — 极简风格 */

.container {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #fafaf8;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
  color: #1a1a1a;
}

.package-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.package-item {
  padding: 28rpx 28rpx;
  border: 2rpx solid #e8e8e6;
  border-radius: 14rpx;
  background-color: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.package-item:active {
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}

.package-item.selected {
  border-color: #1a1a1a;
  box-shadow: 0 0 0 3rpx rgba(0,0,0,0.04);
}

.package-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.package-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.package-price {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.package-desc {
  display: block;
  font-size: 26rpx;
  color: #8a8a8a;
  margin-bottom: 6rpx;
  font-weight: 300;
}

.package-quota {
  font-size: 24rpx;
  color: #bfbfbf;
}

.action-buttons {
  margin-top: 36rpx;
}

.action-buttons .btn {
  width: 100%;
  height: 88rpx;
  background: #1a1a1a;
  color: #ffffff;
  border: none;
  border-radius: 14rpx;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.03em;
}

.action-buttons .btn:active {
  opacity: 0.85;
}

.action-buttons .btn[disabled] {
  background: #e0e0dc;
  color: #bfbfbf;
}
