/* pages/user/user.wxss — 极简风格 */

.container {
  padding: 24rpx;
  padding-bottom: 120rpx;
  min-height: 100vh;
  background-color: #fafaf8;
}

/* 用户卡片 */
.user-card {
  background: #ffffff;
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e6;
  padding: 28rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.user-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #1a1a1a;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.user-info {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 4rpx;
}

.user-date {
  font-size: 24rpx;
  color: #bfbfbf;
  font-weight: 300;
}

/* 配额 */
.quota-row {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.quota-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #e8e8e6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
}

.ring-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.ring-pct {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1;
}

.ring-label {
  font-size: 20rpx;
  color: #bfbfbf;
  font-weight: 400;
  margin-top: 2rpx;
}

.quota-stats {
  display: flex;
  gap: 28rpx;
}

.quota-stat {
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  display: block;
}

.stat-lbl {
  font-size: 22rpx;
  color: #bfbfbf;
  font-weight: 300;
  margin-top: 4rpx;
}

/* 最近任务 */
.section-label {
  font-size: 22rpx;
  font-weight: 500;
  color: #bfbfbf;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 12rpx;
}

.task-mini {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 20rpx;
  background: #ffffff;
  border: 2rpx solid #e8e8e6;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
}

.task-mini-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  color: #1a1a1a;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-pending    { background: #bfbfbf; }
.dot-processing { background: #c08030; }
.dot-completed  { background: #3a8a4a; }
.dot-failed     { background: #e04040; }

.task-mini-date {
  font-size: 22rpx;
  color: #bfbfbf;
}

.task-mini-arrow {
  color: #bfbfbf;
  font-size: 28rpx;
  margin-left: 12rpx;
}

.empty-block {
  text-align: center;
  padding: 64rpx 0;
  color: #bfbfbf;
  font-size: 26rpx;
}

/* 按钮 */
.btn-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 36rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background: #1a1a1a;
  border: none;
  border-radius: 14rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 0.03em;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  width: 100%;
  height: 88rpx;
  background: transparent;
  border: 2rpx solid #e8e8e6;
  border-radius: 14rpx;
  color: #8a8a8a;
  font-size: 28rpx;
  font-weight: 400;
}
