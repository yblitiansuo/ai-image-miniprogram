<!--pages/user/user.wxml-->
<view class="container">
  <!-- 用户卡片 -->
  <view class="user-card">
    <view class="user-row">
      <view class="avatar">{{firstLetter}}</view>
      <view class="user-info">
        <text class="user-name">{{userId}}</text>
        <text class="user-date">加入时间：{{createdAt}}</text>
      </view>
    </view>

    <view class="quota-row">
      <view class="quota-ring">
        <view class="ring-center">
          <text class="ring-pct">{{quotaPct}}</text>
          <text class="ring-label">%</text>
        </view>
      </view>
      <view class="quota-stats">
        <view class="quota-stat">
          <text class="stat-num">{{totalGenerated}}</text>
          <text class="stat-lbl">已生成</text>
        </view>
        <view class="quota-stat">
          <text class="stat-num">{{quota}}</text>
          <text class="stat-lbl">剩余</text>
        </view>
        <view class="quota-stat">
          <text class="stat-num">{{runningTasks}}</text>
          <text class="stat-lbl">进行中</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 最近任务 -->
  <view class="section-label">最近任务</view>
  <view class="task-list" wx:if="{{tasks.length > 0}}">
    <view class="task-mini" wx:for="{{tasks}}" wx:key="id"
          bindtap="previewResult" data-urls="{{item.result_urls}}">
      <view class="task-mini-left">
        <view class="dot dot-{{item.status}}"></view>
        <text>任务 #{{item.id}}</text>
      </view>
      <text class="task-mini-date">{{item.created_at}}</text>
      <text class="task-mini-arrow">›</text>
    </view>
  </view>
  <view class="empty-block" wx:else>
    <text>暂无任务记录</text>
  </view>

  <view class="btn-stack">
    <button class="btn-primary" bindtap="goToPurchase">购买配额</button>
    <button class="btn-secondary" bindtap="onLogout">退出登录</button>
  </view>
</view>
