/* pages/login/login.wxss — 极简风格 */

.login-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #fafaf8;
  padding: 96rpx 44rpx;
}

/* 图标 — CSS 绘制相框 */
.login-icon {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 64rpx;
}

.icon-frame {
  width: 96rpx;
  height: 96rpx;
  border: 3rpx solid #1a1a1a;
  border-radius: 24rpx;
  position: relative;
  opacity: 0.8;
}

.icon-frame::after {
  content: '';
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #1a1a1a;
  border-radius: 50%;
  opacity: 0.5;
}

/* 品牌区 */
.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 96rpx;
}

.brand-name {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  letter-spacing: 0.04em;
}

.brand-tagline {
  font-size: 28rpx;
  color: #8a8a8a;
  font-weight: 300;
}

/* 登录按钮 */
.login-btn {
  width: 100%;
  height: 96rpx;
  background-color: #1a1a1a;
  color: #ffffff;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.04em;
}

.login-btn:active {
  opacity: 0.85;
}

/* 协议 */
.login-terms {
  margin-top: 56rpx;
  text-align: center;
  font-size: 24rpx;
  color: #bfbfbf;
  line-height: 1.6;
  padding: 0 32rpx;
}

.terms-link {
  color: #1a1a1a;
  text-decoration: underline;
}
