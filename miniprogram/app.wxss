/* app.wxss — Gallery Studio 极简风格 */

page {
  --bg: #fafaf8;
  --card: #ffffff;
  --border: #e8e8e6;
  --border-focus: #d0d0ce;
  --text: #1a1a1a;
  --text-secondary: #8a8a8a;
  --text-muted: #bfbfbf;
  --danger: #e04040;
  --success: #3a8a4a;
  --warning: #c08030;
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 8rpx 32rpx rgba(0,0,0,0.06);

  background-color: var(--bg);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: var(--text);
  -webkit-font-smoothing: antialiased;
}

/* 卡片 */
.card {
  background-color: var(--card);
  border-radius: 14rpx;
  border: 2rpx solid var(--border);
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

/* 按钮 */
.btn {
  border-radius: 10rpx;
  font-size: 28rpx;
  padding: 20rpx 40rpx;
  border: none;
  outline: none;
}

.btn-primary {
  background-color: var(--text);
  color: #ffffff;
  font-weight: 500;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background-color: transparent;
  border: 2rpx solid var(--border);
  color: var(--text-secondary);
}

.btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}

/* 输入框 */
.input {
  background-color: var(--bg);
  border: 2rpx solid var(--border);
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  color: var(--text);
  font-size: 28rpx;
}

.input:focus {
  border-color: var(--border-focus);
}

/* 文本 */
.text-primary {
  color: var(--text);
}

.text-secondary {
  color: var(--text-secondary);
  font-size: 26rpx;
}
